[Unit]
Description=QuantaLab FastAPI Backend
After=network.target postgresql.service redis.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/quantalab/backend
EnvironmentFile=/opt/quantalab/backend/.env
ExecStart=/opt/quantalab/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
